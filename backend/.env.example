# FloresByDolly — Plantilla de Variables de Entorno Backend (.env.example)
PORT=3000

# Base de datos MongoDB con autenticación
MONGO_ROOT_USER=flores_admin
MONGO_ROOT_PASSWORD=cambia_esta_contrasena_segura_mongodb
MONGODB_URI=mongodb://flores_admin:cambia_esta_contrasena_segura_mongodb@mongodb:27017/floresbydolly?authSource=admin

# Seguridad JWT
JWT_SECRET=genera_un_secreto_aleatorio_de_64_caracteres_minimo
JWT_EXPIRES_IN=7d

# Almacenamiento en la nube (Cloudinary)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
